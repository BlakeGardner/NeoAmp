[Desktop Entry]
Type=Application
Name=NeoAmp
GenericName=Music Player
Comment=Play music and internet radio with classic Winamp skins
Exec=neoamp %U
Icon=io.github.BlakeGardner.NeoAmp
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=music;audio;player;mp3;flac;playlist;radio;shoutcast;icecast;skin;
MimeType=audio/mpeg;audio/mp2;audio/aac;audio/mp4;audio/x-m4b;audio/vnd.wave;audio/x-aiff;audio/flac;audio/ogg;audio/x-vorbis+ogg;audio/x-mpegurl;application/vnd.apple.mpegurl;audio/x-scpls;
StartupWMClass=neoamp
SingleMainWindow=true
